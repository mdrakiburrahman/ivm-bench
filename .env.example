# ─────────────────────────────────────────────────────────────────────────────
# GitHub repo URL the runner registers against. The runner registration token
# is now auto-minted by src/.scripts/deploy-gh-runner.sh via `gh api`, so
# `gh auth login` is the only credential you need.
# ─────────────────────────────────────────────────────────────────────────────
GH_REPO=https://github.com/mdrakiburrahman/ivm-bench

# ─────────────────────────────────────────────────────────────────────────────
# The resource group and subscription where the infra is deployed
# ─────────────────────────────────────────────────────────────────────────────
TF_RESOURCE_GROUP=ivm-bench-gh-rg
TF_SUBSCRIPTION_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Runner configuration
# ─────────────────────────────────────────────────────────────────────────────
TF_VAR_location=eastus2
TF_VAR_instance_sku=Standard_E32as_v4
TF_VAR_instance_count=2

# ─────────────────────────────────────────────────────────────────────────────
# Terraform state
# ─────────────────────────────────────────────────────────────────────────────
TF_STATE_STORAGE_ACCOUNT_CONTAINER=
TF_STATE_STORAGE_ACCOUNT_KEY=
TF_STATE_STORAGE_ACCOUNT_NAME=

# ─────────────────────────────────────────────────────────────────────────────
# Databricks (databricks-enzyme engine) — names listed for parity with .env
# ─────────────────────────────────────────────────────────────────────────────
DATABRICKS_HOST=
DATABRICKS_SQL_HTTP_PATH=
DATABRICKS_SPN_CLIENT_ID=
DATABRICKS_SPN_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft Fabric target (fabric-openivm-jvm-35 / fabric-jvm-35 engines)
# IDs below are pre-filled from the workspace / lakehouse / environment URLs.
# ─────────────────────────────────────────────────────────────────────────────
FABRIC_API_BASE=https://api.fabric.microsoft.com
FABRIC_CACHE_LAKEHOUSE_NAME=ivmbench_cache
FABRIC_JVM_35_BASE_NAME=jvm_35
FABRIC_ONELAKE_HOST=msit-onelake.dfs.fabric.microsoft.com
FABRIC_OPENIVM_JVM_35_BASE_NAME=openivm_jvm_35
FABRIC_STALE_RESOURCE_MAX_AGE_SECONDS=86400
FABRIC_WORKSPACE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# IMDS relay router
# ─────────────────────────────────────────────────────────────────────────────
IMDS_ROUTER_PORT=8080
IMDS_RELAY_URL=
IMDS_RELAY_SENDER_KEY=
IMDS_RELAY_KEY_NAME=
IDENTITY_HEADER=
UAMI_CLIENT_ID=
UAMI_SUBSCRIPTION=