{
  "_comment": [
    "Single SF=3 experiment across all 6 engines. Used to validate the",
    "incrementalization-coverage section of imgs/benchmark-heuristics.png",
    "without paying the SF=25/100 cost.",
    "",
    "Mirrors the sf3 entry from sf-3-25-100.json exactly so artifacts under",
    "mount/results/3/dbt-server/ and mount/query-plan/3/databricks-enzyme/",
    "are directly comparable.",
    "",
    "Usage (host):",
    "  BENCHMARK_EXPERIMENTS_FILE=src/containers/benchmark-server/experiments/sf-3-only.json \\",
    "    bash src/.scripts/benchmark.sh"
  ],
  "baseline": {
    "engines": ["databricks-enzyme", "spark", "spark-openivm", "duckdb", "duckdb-openivm", "feldera"],
    "parallel": false,
    "feature_flags": {
      "openivm_validate": true,
      "openivm_profile_refresh": true,
      "openivm_query_log": true,
      "preserve_raw": false
    }
  },
  "experiments": [
    {
      "label": "sf3",
      "scale_factor": 3,
      "batch_1_pct": "100",
      "batch_2_pct": "1",
      "batch_3_pct": "1"
    }
  ]
}
