{
  "baseline": {
    "scale_factor": 10,
    "repeated_refresh": true,
    "workload": "standard",
    "refresh_count": 20,
    "refresh_pct": "1",
    "engines": [
      "fabric-openivm-jvm-35"
    ],
    "schedule": "serial",
    "feature_flags": {
      "openivm_validate": true,
      "openivm_profile_refresh": true,
      "openivm_query_log": true,
      "storage_metrics": true,
      "preserve_raw": true,
      "spark_metrics_capture": false
    },
    "spark_tunables": {
      "dbt_threads": 4
    }
  },
  "experiments": [
    {
      "label": "SF10 standard TPC-DI: Fabric OpenIVM, 20 compounded 1% refreshes"
    },
    {
      "label": "SF10 standard TPC-DI: Databricks Enzyme, 20 compounded 1% refreshes",
      "engines": [
        "databricks-enzyme"
      ],
      "spark_tunables": {
        "dbt_threads": 1
      }
    }
  ]
}
