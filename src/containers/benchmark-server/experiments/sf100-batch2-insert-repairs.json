      "batch_2_pct": "35"
    },
    {
      "label": "sf100-batch2-40pct-repair",
      "batch_2_pct": "40"
    },
    {
      "label": "sf100-batch2-45pct-repair",
      "batch_2_pct": "45"
    },
    {
      "label": "sf100-batch2-50pct-repair",
