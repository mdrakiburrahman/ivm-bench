    "feature_flags": {
      "openivm_validate": true,
      "storage_metrics": false,
      "preserve_raw": true,
      "spark_metrics_capture": false
    }
  },
  "experiments": [
    {
      "label": "Extended TPC-DS SF100, insertion 100/1/0.01, serial engines"
    }
