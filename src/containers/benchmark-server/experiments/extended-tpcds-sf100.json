{
  "baseline": {
    "workload": "extended-tpcds",
    "scale_factor": 100,
    "engines": [
      "duckdb",
      "duckdb-openivm",
      "spark",
      "spark-openivm",
      "databricks-enzyme",
      "databricks-openivm",
      "fabric-jvm-35",
      "fabric-openivm-jvm-35",
      "feldera",
      "dbspnet"
    ],
    "schedule": "serial",
    "parallel": false,
    "batch_1_pct": "100",
    "batch_2_pct": "1",
    "batch_3_pct": "0.01",
