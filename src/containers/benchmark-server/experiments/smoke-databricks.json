{
  "_comment": [
    "Single-engine smoke for databricks-enzyme only.",
    "Used to validate pipeline-events capture, refresh-history capture,",
    "warmup, and query-plan capture without paying for the other 5 engines.",
    "",
    "Usage (host):",
    "  BENCHMARK_EXPERIMENTS_FILE=src/containers/benchmark-server/experiments/smoke-databricks.json \\",
    "    bash src/.scripts/benchmark.sh"
  ],
  "baseline": {
    "engines": ["databricks-enzyme"],
    "parallel": false,
    "feature_flags": {
      "openivm_validate": false,
      "openivm_profile_refresh": false,
      "openivm_query_log": false,
      "preserve_raw": false
    }
  },
  "experiments": [
    {
      "label": "smoke-databricks",
      "scale_factor": 3,
      "batch_1_pct": "100",
      "batch_2_pct": "1",
      "batch_3_pct": "1"
    }
  ]
}
