{
  "_comment": [
    "All-engines sweep at SF=3, 25, 100 (100/1/1 batches).",
    "Used to generate the three primary scale-factor diagrams under imgs/.",
    "Validation ON across the openivm engines.",
    "",
    "databricks-enzyme reports PURE COMPUTE TIME (Lakeflow pipeline orchestration",
    "overhead is excluded from batch.duration_s and per-model execution_time_s).",
    "See services/databricks_enzyme_compute.py for derivation details and",
    "mount/results/<sf>/dbt-server/databricks-compute-batch<N>.json for forensics.",
    "",
    "Usage (host):",
    "  BENCHMARK_EXPERIMENTS_FILE=src/containers/benchmark-server/experiments/sf-3-25-100.json \\",
    "    bash src/.scripts/benchmark.sh"
  ],
  "baseline": {
    "engines": ["databricks-enzyme", "spark", "spark-openivm", "duckdb", "duckdb-openivm", "feldera"],
    "parallel": false,
    "feature_flags": {
      "openivm_validate": true,
      "openivm_profile_refresh": true,
      "openivm_query_log": true,
      "preserve_raw": false
    }
  },
  "experiments": [
    {
      "label": "sf3",
      "scale_factor": 3,
      "batch_1_pct": "100",
      "batch_2_pct": "1",
      "batch_3_pct": "1"
    },
    {
      "label": "sf25",
      "scale_factor": 25,
      "batch_1_pct": "100",
      "batch_2_pct": "1",
      "batch_3_pct": "1"
    },
    {
      "label": "sf100",
      "scale_factor": 100,
      "batch_1_pct": "100",
      "batch_2_pct": "1",
      "batch_3_pct": "1"
    }
  ]
}
