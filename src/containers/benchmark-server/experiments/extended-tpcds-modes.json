{
  "_design_notes": [
    "All 96 models, fixed report date, strict materialized-view policy and fresh full-DAG validation after each snapshot.",
    "Daily arrivals and repeated insertions include a fourth snapshot; batch-three percentages repeat for later batches.",
    "Both engines replay the same immutable row images for each experiment."
  ],
  "baseline": {
    "workload": "extended-tpcds",
    "scale_factor": 0.01,
    "engines": [
      "duckdb",
      "duckdb-openivm"
    ],
    "schedule": "serial",
    "batch_1_pct": "100",
    "extended_tpcds": {
      "report_date": "2002-12-31",
      "seed": 17,
      "batches": 3,
      "days": 3,
      "fallback_policy": "strict"
    },
    "feature_flags": {
      "openivm_validate": true,
      "storage_metrics": false
    }
  },
