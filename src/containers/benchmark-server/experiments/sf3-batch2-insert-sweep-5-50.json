{
  "_design_notes": [
    "SF3 diagnostic sweep over 5%-50% of the official TPC-DI Batch 2.",
    "Only DuckDB and DuckDB-OpenIVM run; Batch 3 is held at 0.01%.",
    "Every experiment records exact physical source rows in source-row-counts.json."
  ],
  "baseline": {
    "scale_factor": 3,
    "batch_1_pct": "100",
    "batch_3_pct": "0.01",
    "batch_2_update_pct": "0",
    "batch_2_delete_pct": "0",
    "batch_3_update_pct": "0",
    "batch_3_delete_pct": "0",
    "engines": ["duckdb", "duckdb-openivm"],
    "schedule": "serial",
    "feature_flags": {
      "openivm_validate": false,
      "openivm_profile_refresh": true,
      "openivm_query_log": true,
      "storage_metrics": true,
      "preserve_raw": false,
      "spark_metrics_capture": false
    }
  },
  "experiments": [
