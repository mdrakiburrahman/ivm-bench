    { "label": "sf3-batch2-10pct", "batch_2_pct": "10" },
    { "label": "sf3-batch2-15pct", "batch_2_pct": "15" },
    { "label": "sf3-batch2-20pct", "batch_2_pct": "20" },
    { "label": "sf3-batch2-25pct", "batch_2_pct": "25" },
    { "label": "sf3-batch2-30pct", "batch_2_pct": "30" },
    { "label": "sf3-batch2-35pct", "batch_2_pct": "35" },
    { "label": "sf3-batch2-40pct", "batch_2_pct": "40" },
    { "label": "sf3-batch2-45pct", "batch_2_pct": "45" },
    { "label": "sf3-batch2-50pct", "batch_2_pct": "50" }
  ]
