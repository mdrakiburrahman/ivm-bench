{
  "_comment": [
    "GCI staging run for compiler-bench over the first 500 corpus queries.",
    "Run this before the complete 2,505-query experiment to validate the remote runner,",
    "all five local engine adapters, and uploaded CSV artifacts."
  ],
  "baseline": {
    "engines": [
      "duckdb",
      "duckdb-openivm",
      "spark",
      "spark-openivm",
      "feldera"
    ],
    "parallel": false,
    "schedule": "serial",
    "feature_flags": {
      "compiler_bench": true,
      "openivm_validate": false,
      "openivm_profile_refresh": false,
      "openivm_query_log": true,
      "storage_metrics": false,
      "spark_metrics_capture": false
    },
    "compiler_bench": {
      "scale_factor": 3,
      "timeout_s": 60,
      "limit": 500,
      "verify": true,
      "delta_batch_size": 10,
      "ducklake": false
    }
  },
  "experiments": [
    {
      "label": "compiler-bench-gci-500",
      "scale_factor": 3,
      "batch_1_pct": "100",
      "batch_2_pct": "1",
      "batch_3_pct": "1"
    }
  ]
}
