diff --git a/spark-ext/ivm-compiler/src/main/scala/org/openivm/spark/compiler/SparkFunctionShimSql.scala b/spark-ext/ivm-compiler/src/main/scala/org/openivm/spark/compiler/SparkFunctionShimSql.scala
index 727217f..238a0df 100644
--- a/spark-ext/ivm-compiler/src/main/scala/org/openivm/spark/compiler/SparkFunctionShimSql.scala
+++ b/spark-ext/ivm-compiler/src/main/scala/org/openivm/spark/compiler/SparkFunctionShimSql.scala
@@ -36,0 +37,97 @@ private[compiler] object SparkFunctionShimSql {
+  private val QualifiedSystemAdd =
+    """(?i)(?:"system"|`system`|system)\s*\.\s*(?:"main"|`main`|main)\s*\.\s*(?:"add"|`add`|add)""".r.pattern
+  private val QualifiedSystemInterval =
+    """(?i)(?:"system"|`system`|system)\s*\.\s*(?:"main"|`main`|main)\s*\.\s*(?:"(to_(?:microseconds|milliseconds|seconds|minutes|hours|days|months|years))"|`(to_(?:microseconds|milliseconds|seconds|minutes|hours|days|months|years))`|(to_(?:microseconds|milliseconds|seconds|minutes|hours|days|months|years)))""".r.pattern
+  private val QualifiedSystemFunction =
+    """(?i)(?:"system"|`system`|system)\s*\.\s*(?:"main"|`main`|main)\s*\.\s*(?:"([a-z_][a-z_0-9]*)"|`([a-z_][a-z_0-9]*)`|([a-z_][a-z_0-9]*))""".r.pattern
+
+  /** DuckDB 2.0 qualifies built-in functions with system.main. Restore the
+    * unqualified calls before Spark dialect rewrites, including interval
+    * arithmetic that must become an infix expression.
+    */
+  private[compiler] def rewriteQualifiedSystemIntervals(sql: String): String =
+    rewriteOutsideProtected(sql, protectDoubleQuotes = false) { i =>
+      val boundary =
+        i == 0 || !(sql.charAt(i - 1).isLetterOrDigit || sql.charAt(i - 1) == '_' || sql.charAt(i - 1) == '.')
+      if (!boundary) None
+      else {
+        val add = QualifiedSystemAdd.matcher(sql).region(i, sql.length)
+        if (add.lookingAt()) {
+          parseFunctionCall(sql, add.end()).filter(_.topLevelCommaCount == 1).flatMap { call =>
+            splitTopLevelArgs(sql, call).collect { case Seq(left, right) =>
+              val lhs = rewriteQualifiedSystemIntervals(sql.substring(left._1, left._2).trim)
+              val rhs = rewriteQualifiedSystemIntervals(sql.substring(right._1, right._2).trim)
+              (call.closeParen + 1, s"(($lhs) + ($rhs))")
+            }
+          }
+        } else {
+          val unit = QualifiedSystemInterval.matcher(sql).region(i, sql.length)
+          if (unit.lookingAt() && parseFunctionCall(sql, unit.end()).isDefined)
+            Some(unit.end() -> Seq(unit.group(1), unit.group(2), unit.group(3)).find(_ != null).get)
+          else {
+            val builtin = QualifiedSystemFunction.matcher(sql).region(i, sql.length)
+            if (builtin.lookingAt() && parseFunctionCall(sql, builtin.end()).isDefined)
+              Some(builtin.end() -> Seq(builtin.group(1), builtin.group(2), builtin.group(3)).find(_ != null).get)
+            else None
+          }
+        }
+      }
+    }
+
+  private val OffsetWindowFunction = "(?i)(?:lag|lead)".r.pattern
+
+  /** DuckDB serializes a frame for LAG/LEAD even though these functions do
+    * not use it. Spark rejects any explicit frame on either function.
+    */
+  private[compiler] def rewriteOffsetWindowFrames(sql: String): String =
+    rewriteOutsideProtected(sql, protectBackticks = true) { i =>
+      val boundary = i == 0 || !(sql.charAt(i - 1).isLetterOrDigit || sql.charAt(i - 1) == '_')
+      if (!boundary) None
+      else {
+        val offset = OffsetWindowFunction.matcher(sql).region(i, sql.length)
+        if (!offset.lookingAt()) None
+        else
+          parseFunctionCall(sql, offset.end()).flatMap { args =>
+            val overStart = skipTriviaForward(sql, args.closeParen + 1, sql.length)
+            val overEnd   = overStart + 4
+            if (
+              overEnd > sql.length || !sql.regionMatches(true, overStart, "OVER", 0, 4) ||
+              !hasRightIdentifierBoundary(sql, overEnd)
+            ) None
+            else
+              parseFunctionCall(sql, overEnd).flatMap { window =>
+                val frame = Seq("ROWS", "RANGE", "GROUPS")
+                  .flatMap(findTopLevelKeyword(sql, window.openParen + 1, window.closeParen, _))
+                  .sorted
+                  .headOption
+                frame.map { start =>
+                  val prefix = sql.substring(i, start).reverse.dropWhile(_.isWhitespace).reverse
+                  (window.closeParen + 1, prefix + ")")
+                }
+              }
+          }
+      }
+    }
+
+  private val TemporalUnitCall =
+    """(?i)to_(microseconds|milliseconds|seconds|minutes|hours|days|months|years)""".r.pattern
+
+  private[compiler] def rewriteTemporalUnitConstructors(sql: String): String =
+    rewriteOutsideProtected(sql, protectBackticks = true) { i =>
+      val boundary =
+        i == 0 || !(sql.charAt(i - 1).isLetterOrDigit || sql.charAt(i - 1) == '_' || sql.charAt(i - 1) == '.')
+      if (!boundary) None
+      else {
+        val unit = TemporalUnitCall.matcher(sql).region(i, sql.length)
+        if (!unit.lookingAt()) None
+        else
+          parseFunctionCall(sql, unit.end()).filter(_.topLevelCommaCount == 0).map { call =>
+            val arg = rewriteTemporalUnitConstructors(call.args(sql)).trim
+            (
+              call.closeParen + 1,
+              s"(($arg) * INTERVAL 1 ${unit.group(1).dropRight(1).toUpperCase(java.util.Locale.ROOT)})"
+            )
+          }
+      }
+    }
+
diff --git a/spark-ext/ivm-compiler/src/test/scala/org/openivm/spark/compiler/LptsSparkDialectSpec.scala b/spark-ext/ivm-compiler/src/test/scala/org/openivm/spark/compiler/LptsSparkDialectSpec.scala
index 7aa2e50..cf05285 100644
--- a/spark-ext/ivm-compiler/src/test/scala/org/openivm/spark/compiler/LptsSparkDialectSpec.scala
+++ b/spark-ext/ivm-compiler/src/test/scala/org/openivm/spark/compiler/LptsSparkDialectSpec.scala
@@ -4,0 +5 @@ import org.scalatest.matchers.should.Matchers
+import org.apache.spark.sql.catalyst.parser.CatalystSqlParser
@@ -12,0 +14,48 @@ class LptsSparkDialectSpec extends AnyFunSpec with Matchers {
+  describe("DuckDB 2.0 qualified interval functions") {
+    it("translates the initial-load interval expression without catalog-qualified functions") {
+      val sql = """SELECT ts - "system".main."add"("system".main."add"(
+        |"system".main.to_months(0), "system".main.to_days(0)),
+        |"system".main.to_microseconds(CAST(1000 AS BIGINT))) AS shifted FROM t""".stripMargin
+      val translated = LptsSparkDialect.translate(sql)
+      translated should include("INTERVAL 1 MONTH")
+      translated should include("INTERVAL 1 DAY")
+      translated should include("INTERVAL 1 MICROSECOND")
+      translated should not include "system"
+      translated should not include "add("
+      noException should be thrownBy CatalystSqlParser.parsePlan(translated)
+      LptsSparkDialect.translate(translated) shouldBe translated
+    }
+
+    it("leaves quoted identifiers, strings, and comments alone") {
+      val sql = """SELECT 'system.main.add(1, 2)', "system.main.add", x
+        |-- system.main.add(1, 2)
+        |/* system.main.to_days(1) */ FROM t""".stripMargin
+      LptsSparkDialect.translate(sql) should include("'system.main.add(1, 2)'")
+      LptsSparkDialect.translate(sql) should include("/* system.main.to_days(1) */")
+      LptsSparkDialect.translate(sql) should include("\"system.main.add\"")
+    }
+
+    it("dequalifies other built-in calls before translating nested struct fields") {
+      val sql = """SELECT "system"."main"."struct_extract"(
+        |  "system"."main"."struct_extract"(Customer, 'Name'), 'C_F_NAME') AS first_name FROM t""".stripMargin
+      val translated = LptsSparkDialect.translate(sql)
+      translated should include("Customer.Name.C_F_NAME")
+      translated should not include "system"
+      noException should be thrownBy CatalystSqlParser.parsePlan(translated)
+    }
+
+    it("removes DuckDB's unused LAG and LEAD frames accepted by Spark") {
+      val sql = """SELECT lag(th_dts) OVER (PARTITION BY t_id ORDER BY th_dts DESC
+        |  ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),
+        |lead(th_dts, 1) OVER (PARTITION BY t_id ORDER BY th_dts
+        |  RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING),
+        |sum(amount) OVER (PARTITION BY t_id ORDER BY th_dts
+        |  ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM t""".stripMargin
+      val translated = LptsSparkDialect.translate(sql)
+      translated.toUpperCase(java.util.Locale.ROOT).split("ROWS BETWEEN", -1).length shouldBe 2
+      translated.toUpperCase(java.util.Locale.ROOT) should not include "RANGE BETWEEN"
+      noException should be thrownBy CatalystSqlParser.parsePlan(translated)
+      LptsSparkDialect.translate(translated) shouldBe translated
+    }
+  }
+
