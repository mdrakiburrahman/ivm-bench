# Exact RisingWave source used by the GCI benchmark. Keep the full SHA: branch
# names are mutable and would make storage comparisons impossible to reproduce.
RISINGWAVE_GIT_REPOSITORY=https://github.com/ila/risingwave.git
RISINGWAVE_GIT_SHA=eceb7a9e97979634d910a339cb37ba1719b1271b

# Only the patched, statically linked Rust binary is replaced. The surrounding
# runtime stays identical to the benchmark's previous v3.0.2 image.
RISINGWAVE_BASE_IMAGE=risingwavelabs/risingwave:v3.0.2
RISINGWAVE_PINNED_IMAGE=ivm-bench/risingwave:eceb7a9e97979634d910a339cb37ba1719b1271b
